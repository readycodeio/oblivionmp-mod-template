<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- References the whole client SDK. The generator is an Analyzer; example mods are excluded.
         Private=false: the host provides these assemblies at runtime. -->
    <ItemGroup>
        <ClientSdkAssembly Include="..\Dependencies\Client\*.dll"
                           Exclude="..\Dependencies\Client\ReadyM.Api.Generators.dll;..\Dependencies\Client\OblivionMp.TestMod*.dll;..\Dependencies\Client\OblivionMpCSharpMod.dll" />
        <Reference Include="@(ClientSdkAssembly)">
            <Private>false</Private>
        </Reference>
        <Analyzer Include="..\Dependencies\Client\ReadyM.Api.Generators.dll" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ExampleMod.Common\ExampleMod.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    </ItemGroup>

</Project>
