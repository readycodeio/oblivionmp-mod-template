<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Reference only the DLLs this mod actually needs. Pulling in the whole SDK folder makes the
         compiler record references the game client can't all satisfy at load time, which makes the
         mod loader silently skip the mod. Private=false: the host provides these at runtime. -->
    <ItemGroup>
        <Reference Include="..\Dependencies\Client\OblivionMp.Sdk.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\ReadyM.Sdk.Common.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\ReadyM.Api.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\ReadyM.Api.Multiplayer.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\Friflo.Engine.ECS.dll">
            <Private>false</Private>
        </Reference>
        <Reference Include="..\Dependencies\Client\LiteNetLib.dll">
            <Private>false</Private>
        </Reference>
        <Analyzer Include="..\Dependencies\Client\ReadyM.Api.Generators.dll" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ExampleMod.Common\ExampleMod.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    </ItemGroup>

</Project>
